Yn :: (order: s32, x: float64) -> float64 #foreign libm "yn";

#scope_export
IsFinite :: (x: float64) -> s32 {
    if x - x == 0.0 { return 1 }
    return 0
}

IsNan :: (x: float64) -> s32 {
    if x != x { return 1 }
    return 0
}

Infinity :: () -> float64 {
    return 1.0 / float_zero
}

NotANumber :: () -> float64 {
    return float_zero / float_zero
}

// C's float-to-integer conversions as x86-64 performs them: truncate toward
// zero, and give the minimum signed value for NaN or a value out of range.
// A value just below -2^31 truncates to one that fits, but Ziran checks the
// float itself against the type's range, so the 32-bit conversion goes
// through the 64-bit one.
TruncateToS32 :: (x: float64) -> s32 {
    if x > -2147483649.0 && x < 2147483648.0 { return cast(s32)TruncateToS64(x) }
    return -2147483647 - 1
}

TruncateToS64 :: (x: float64) -> s64 {
    if x >= -9223372036854775808.0 && x < 9223372036854775808.0 { return cast(s64)x }
    return -9223372036854775807 - 1
}

TruncateToU32 :: (x: float64) -> u32 {
    return cast(u32)(cast(u64)TruncateToS64(x) & 4294967295)
}

// Like the compiler's sequence for a double to a 64-bit unsigned integer:
// values below 2^63 convert as signed; the rest are shifted down first. NaN
// fails the comparison, so it takes the signed path and becomes 2^63.
TruncateToU64 :: (x: float64) -> u64 {
    if !(x >= 9223372036854775808.0) { return cast(u64)TruncateToS64(x) }
    return cast(u64)TruncateToS64(x - 9223372036854775808.0) ^ 9223372036854775808
}

// ---------------------------------------------------- regular expressions

// glibc's regex_t is 64 bytes on 64-bit Linux; the engine only passes it
// to the regex functions.
RegexPattern :: struct {
    storage: [8]u64
}

RegexMatch :: struct {
    rm_so: s32
    rm_eo: s32
}

#scope_module
RegexCompile :: (pattern: *RegexPattern, text: *s8, flags: s32) -> s32 #foreign libc "regcomp";
AbiRegexExecute :: (pattern: *RegexPattern, text: *s8, match_count: usize, matches: *RegexMatch, flags: s32) -> s32 #foreign libc "regexec";
RegexExecute :: (pattern: *RegexPattern, text: *s8, match_count: u64, matches: *RegexMatch, flags: s32) -> s32 { return AbiRegexExecute(pattern, text, cast(usize)match_count, matches, flags) }
RegexFree :: (pattern: *RegexPattern) #foreign libc "regfree";

// ------------------------------------------------------------------- time

#scope_export
CalendarTime :: struct {
    tm_sec: s32
    tm_min: s32
    tm_hour: s32
    tm_mday: s32
    tm_mon: s32
    tm_year: s32
    tm_wday: s32
    tm_yday: s32
    tm_isdst: s32
    tm_gmtoff: isize
    tm_zone: *s8
}

#scope_module
#if #defined(ANDROID_BUILD) {
    // bionic time_t is long (32 bits on ARM32); Emscripten uses 64 bits.
    AndroidTime :: (result: *isize) -> isize #foreign libc "time";
    AndroidLocalTime :: (time: *isize) -> *CalendarTime #foreign libc "localtime";
    #scope_export
    CurrentTime :: (result: *s64) -> s64 {
        value := cast(s64)AndroidTime(null)
        if result != null { result.* = value }
        return value
    }
    LocalTime :: (time: *s64) -> *CalendarTime {
        value := cast(isize)time.*
        return AndroidLocalTime(*value)
    }
    #scope_module
} else {
    CurrentTime :: (result: *s64) -> s64 #foreign libc "time";
    LocalTime :: (time: *s64) -> *CalendarTime #foreign libc "localtime";
}

// ------------------------------------------------------------------ files

#scope_export
// Reads a whole file into newly allocated memory. Returns null when the
// file cannot be read; release the bytes with FreeFileBytes.
ReadFileBytes :: (path: *s8, size: *s32) -> *u8 {
    size.* = 0
    file: *void = OpenFile(path, CText("rb"))
    if file == null { return null }
    if SeekFile(file, 0, 2) != 0 {
        CloseFile(file)
        return null
    }
    length: s64 = TellFile(file)
    if length < 0 || SeekFile(file, 0, 0) != 0 {
        CloseFile(file)
        return null
    }
    data: *u8 = cast(*u8)MemoryAllocate(cast(u64)length + 1)
    if data == null {
        CloseFile(file)
        return null
    }
    count: u64 = ReadFile(cast(*void)data, 1, cast(u64)length, file)
    CloseFile(file)
    data[count] = 0
    size.* = cast(s32)count
    return data
}

FreeFileBytes :: (data: *u8) {
    MemoryFree(cast(*void)data)
}

// Writes NUL-terminated text to a file, replacing its contents.
WriteFileText :: (path: *s8, text: *s8) -> bool {
    file: *void = OpenFile(path, CText("wb"))
    if file == null { return false }
    length: u64 = TextLength(text)
    written: u64 = WriteFile(cast(*void)text, 1, length, file)
    closed: s32 = CloseFile(file)
    return written == length && closed == 0
}

#scope_file

OpenFile :: (path: *s8, mode: *s8) -> *void #foreign libc "fopen";
CloseFile :: (file: *void) -> s32 #foreign libc "fclose";
AbiSeekFile :: (file: *void, offset: isize, origin: s32) -> s32 #foreign libc "fseek";
SeekFile :: (file: *void, offset: s64, origin: s32) -> s32 { return AbiSeekFile(file, cast(isize)offset, origin) }
AbiTellFile :: (file: *void) -> isize #foreign libc "ftell";
TellFile :: (file: *void) -> s64 { return cast(s64)AbiTellFile(file) }
AbiReadFile :: (output: *void, size: usize, count: usize, file: *void) -> usize #foreign libc "fread";
ReadFile :: (output: *void, size: u64, count: u64, file: *void) -> u64 { return cast(u64)AbiReadFile(output, cast(usize)size, cast(usize)count, file) }
AbiWriteFile :: (input: *void, size: usize, count: usize, file: *void) -> usize #foreign libc "fwrite";
WriteFile :: (input: *void, size: u64, count: u64, file: *void) -> u64 { return cast(u64)AbiWriteFile(input, cast(usize)size, cast(usize)count, file) }

float_zero: float64 = 0.0;

LiteralEntry :: struct {
    text: *s8
    length: s64
    hash: u64
}

literal_table: *LiteralEntry;
literal_table_capacity: s64 = 0;
literal_table_count: s64 = 0;

LiteralHash :: (literal: string) -> u64 {
    hash: u64 = 14695981039346656037
    index: s64 = 0
    while index < literal.count {
        hash = (hash ^ cast(u64)literal[index]) * 1099511628211
        index += 1
    }
    return hash
}

SameLiteral :: (text: *s8, literal: string) -> bool {
    index: s64 = 0
    while index < literal.count {
        if cast(u8)text[index] != literal[index] { return false }
        index += 1
    }
    return true
}

GrowLiteralTable :: () {
    old_table: *LiteralEntry = literal_table
    old_capacity: s64 = literal_table_capacity
    capacity: s64 = 1024
    if old_capacity > 0 { capacity = old_capacity * 2 }
    literal_table = cast(*LiteralEntry)MemoryAllocateZeroed(cast(u64)capacity, cast(u64)size_of(LiteralEntry))
    literal_table_capacity = capacity
    mask: u64 = cast(u64)capacity - 1
    index: s64 = 0
    while index < old_capacity {
        entry: *LiteralEntry = *old_table[index]
        if entry.text != null {
            slot: u64 = entry.hash & mask
            while literal_table[slot].text != null {
                slot = (slot + 1) & mask
            }
            literal_table[slot] = entry.*
        }
        index += 1
    }
    if old_table != null { MemoryFree(cast(*void)old_table) }
}

// Compares like strcmp or strncmp (limit >= 0), optionally folding ASCII case.
CompareLiteral :: (text: *s8, literal: string, limit: s64, fold: bool) -> s32 {
    index: s64 = 0
    while limit < 0 || index < limit {
        left: s32 = cast(u8)text[index]
        right: s32 = 0
        if index < literal.count { right = literal[index] }
        if fold {
            left = LowerByte(left)
            right = LowerByte(right)
        }
        if left != right { return left - right }
        if left == 0 { return 0 }
        index += 1
    }
    return 0
}
