// Native services for the spreadsheet engine: memory, C text, number
// parsing and formatting, the C math library, POSIX regular expressions,
// local time, and whole-file I/O. The engine keeps text as NUL-terminated
// bytes (*s8), so these procedures follow C string semantics exactly.

#scope_module
libc :: #system_library "libc";
libm :: #system_library "m";

// ------------------------------------------------------------------ memory

AbiMemoryAllocate :: (size: usize) -> *void #foreign libc "malloc";
MemoryAllocate :: (size: u64) -> *void { return AbiMemoryAllocate(cast(usize)size) }
AbiMemoryAllocateZeroed :: (count: usize, size: usize) -> *void #foreign libc "calloc";
MemoryAllocateZeroed :: (count: u64, size: u64) -> *void { return AbiMemoryAllocateZeroed(cast(usize)count, cast(usize)size) }
AbiMemoryResize :: (block: *void, size: usize) -> *void #foreign libc "realloc";
MemoryResize :: (block: *void, size: u64) -> *void { return AbiMemoryResize(block, cast(usize)size) }
MemoryFree :: (block: *void) #foreign libc "free";
AbiMemoryCopy :: (destination: *void, source: *void, count: usize) -> *void #foreign libc "memcpy";
MemoryCopy :: (destination: *void, source: *void, count: u64) -> *void { return AbiMemoryCopy(destination, source, cast(usize)count) }
AbiMemoryMove :: (destination: *void, source: *void, count: usize) -> *void #foreign libc "memmove";
MemoryMove :: (destination: *void, source: *void, count: u64) -> *void { return AbiMemoryMove(destination, source, cast(usize)count) }
AbiMemorySet :: (destination: *void, value: s32, count: usize) -> *void #foreign libc "memset";
MemorySet :: (destination: *void, value: s32, count: u64) -> *void { return AbiMemorySet(destination, value, cast(usize)count) }

// ------------------------------------------------------------------- text

AbiTextLength :: (text: *s8) -> usize #foreign libc "strlen";
TextLength :: (text: *s8) -> u64 { return cast(u64)AbiTextLength(text) }
TextCompare :: (left: *s8, right: *s8) -> s32 #foreign libc "strcmp";
AbiTextCompareN :: (left: *s8, right: *s8, count: usize) -> s32 #foreign libc "strncmp";
TextCompareN :: (left: *s8, right: *s8, count: u64) -> s32 { return AbiTextCompareN(left, right, cast(usize)count) }
TextCompareFold :: (left: *s8, right: *s8) -> s32 #foreign libc "strcasecmp";
AbiTextCompareFoldN :: (left: *s8, right: *s8, count: usize) -> s32 #foreign libc "strncasecmp";
TextCompareFoldN :: (left: *s8, right: *s8, count: u64) -> s32 { return AbiTextCompareFoldN(left, right, cast(usize)count) }
TextFind :: (haystack: *s8, needle: *s8) -> *s8 #foreign libc "strstr";
TextFindByte :: (text: *s8, byte: s32) -> *s8 #foreign libc "strchr";
TextAppend :: (destination: *s8, source: *s8) -> *s8 #foreign libc "strcat";
FormatText :: (output: *s8, capacity: usize, format: *s8, args: ..any) -> s32 #foreign libc "snprintf";
ParseDouble :: (text: *s8, end: **s8) -> float64 #foreign libc "strtod";
AbiParseLong :: (text: *s8, end: **s8, base: s32) -> isize #foreign libc "strtol";
ParseLong :: (text: *s8, end: **s8, base: s32) -> s64 { return cast(s64)AbiParseLong(text, end, base) }
ParseLongLong :: (text: *s8, end: **s8, base: s32) -> s64 #foreign libc "strtoll";
EnvironmentValue :: (name: *s8) -> *s8 #foreign libc "getenv";

#scope_export
// Byte classification in the C locale. Values outside ASCII never match.
IsAlphaByte :: (byte: s32) -> s32 {
    if byte >= 65 && byte <= 90 { return 1 }
    if byte >= 97 && byte <= 122 { return 1 }
    return 0
}

IsDigitByte :: (byte: s32) -> s32 {
    if byte >= 48 && byte <= 57 { return 1 }
    return 0
}

IsSpaceByte :: (byte: s32) -> s32 {
    if byte == 32 || (byte >= 9 && byte <= 13) { return 1 }
    return 0
}

LowerByte :: (byte: s32) -> s32 {
    if byte >= 65 && byte <= 90 { return byte + 32 }
    return byte
}

UpperByte :: (byte: s32) -> s32 {
    if byte >= 97 && byte <= 122 { return byte - 32 }
    return byte
}

// strcmp against a source literal: the sign of the first differing byte,
// compared as unsigned values.
TextCompareLiteral :: (text: *s8, literal: string) -> s32 {
    return CompareLiteral(text, literal, -1, false)
}

TextCompareNLiteral :: (text: *s8, literal: string, count: u64) -> s32 {
    return CompareLiteral(text, literal, cast(s64)count, false)
}

TextCompareFoldLiteral :: (text: *s8, literal: string) -> s32 {
    return CompareLiteral(text, literal, -1, true)
}

TextCompareFoldNLiteral :: (text: *s8, literal: string, count: u64) -> s32 {
    return CompareLiteral(text, literal, cast(s64)count, true)
}

// strstr with a source literal needle.
TextFindLiteral :: (haystack: *s8, needle: string) -> *s8 {
    if needle.count == 0 { return haystack }
    start: s64 = 0
    while haystack[start] != 0 {
        index: s64 = 0
        while index < needle.count && cast(u8)haystack[start + index] == needle[index] {
            index += 1
        }
        if index == needle.count { return *haystack[start] }
        start += 1
    }
    return null
}

// Copies a literal and its terminator into caller-owned storage.
TextSet :: (output: *s8, literal: string) {
    index: s64 = 0
    while index < literal.count {
        output[index] = cast(s8)literal[index]
        index += 1
    }
    output[literal.count] = 0
}

// Returns a NUL-terminated copy of a source literal. Each distinct literal
// is copied once and kept for the life of the program.
CText :: (literal: string) -> *s8 {
    hash := LiteralHash(literal)
    if literal_table_capacity == 0 || (literal_table_count + 1) * 2 > literal_table_capacity {
        GrowLiteralTable()
    }
    mask: u64 = cast(u64)literal_table_capacity - 1
    slot: u64 = hash & mask
    while literal_table[slot].text != null {
        entry: *LiteralEntry = *literal_table[slot]
        if entry.hash == hash && entry.length == literal.count && SameLiteral(entry.text, literal) {
            return entry.text
        }
        slot = (slot + 1) & mask
    }
    copy: *s8 = cast(*s8)MemoryAllocate(cast(u64)literal.count + 1)
    TextSet(copy, literal)
    literal_table[slot].text = copy
    literal_table[slot].length = literal.count
    literal_table[slot].hash = hash
    literal_table_count += 1
    return copy
}

