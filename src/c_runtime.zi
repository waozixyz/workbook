Cos :: (x: float64) -> float64 #foreign libm "cos";
Tan :: (x: float64) -> float64 #foreign libm "tan";
Asin :: (x: float64) -> float64 #foreign libm "asin";
Acos :: (x: float64) -> float64 #foreign libm "acos";
Atan :: (x: float64) -> float64 #foreign libm "atan";
Atan2 :: (y: float64, x: float64) -> float64 #foreign libm "atan2";
Sinh :: (x: float64) -> float64 #foreign libm "sinh";
Cosh :: (x: float64) -> float64 #foreign libm "cosh";
Tanh :: (x: float64) -> float64 #foreign libm "tanh";
Asinh :: (x: float64) -> float64 #foreign libm "asinh";
Acosh :: (x: float64) -> float64 #foreign libm "acosh";
Atanh :: (x: float64) -> float64 #foreign libm "atanh";
Erf :: (x: float64) -> float64 #foreign libm "erf";
Erfc :: (x: float64) -> float64 #foreign libm "erfc";
