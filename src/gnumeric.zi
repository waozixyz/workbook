NativeResolve :: (slot: *void, name: string) -> bool {
    symbol: *void = NativeSymbol(native_library, CText(name))
    if symbol == null { return false }
    MemoryCopy(slot, cast(*void)*symbol, size_of(*void))
    return true
}

NativeSubtotalCollector :: struct {
    values: *float64;
    count: s32;
    capacity: s32;
    function: s32;
    ignore_hidden: bool;
    base_position: *NativeEvalPosition;
}

NativeSubtotalVisit :: (
    position: *NativeEvalPosition,
    value: *void,
    closure: *void
) -> *void {
    collector: *NativeSubtotalCollector = cast(*NativeSubtotalCollector)closure
    if collector.ignore_hidden && position != collector.base_position && position.sheet != null &&
            native_row_hidden(position.sheet, position.eval.row) != 0 {
        return null
    }
    kind: s32 = ifx value == null then 10 else native_value_type(value)
    number: float64 = 0
    if kind == 40 {
        number = native_number(value)
    } else if kind == 20 || kind == 50 || kind == 60 {
        if collector.function == 3 {
            number = 0
        } else if kind == 50 && collector.function == 2 {
            return null
        } else if kind != 50 {
            return null
        } else {
            return native_value_duplicate(value)
        }
    } else if kind != 10 {
        return native_new_error_value(position)
    } else {
        return null
    }
    if collector.count == collector.capacity {
        collector.capacity = collector.capacity * 2 + 16
        collector.values = cast(*float64)native_realloc(
            cast(*void)collector.values,
            cast(usize)collector.capacity * size_of(float64)
        )
    }
    collector.values[collector.count] = number
    collector.count += 1
    return null
}

NativeSubtotal :: (eval_info: *NativeFunctionEvalInfo, argc: s32, argv: **void) -> *void {
    if eval_info == null || eval_info.position == null { return null }
    if argv == null || argc < 1 {
        return native_new_error_num(eval_info.position)
    }
    function_value: *void = native_expression_evaluate(argv[0], eval_info.position, 0)
    if function_value == null {
        return native_new_error_num(eval_info.position)
    }
    if native_value_type(function_value) == 50 { return function_value }
    function: s32 = native_value_as_int(function_value)
    native_value_release(function_value)
    ignore_hidden: bool = function >= 101 && function <= 111
    if ignore_hidden { function -= 100 }
    if function < 1 || function > 11 {
        return native_new_error_num(eval_info.position)
    }

    aggregate: NativeRangeFunction = native_range_average
    if function == 1 { aggregate = native_range_average }
    else if function == 2 || function == 3 { aggregate = native_range_count }
    else if function == 4 { aggregate = native_range_maximum }
    else if function == 5 { aggregate = native_range_minimum }
    else if function == 6 { aggregate = native_range_product }
    else if function == 7 { aggregate = native_range_stddev_estimate }
    else if function == 8 { aggregate = native_range_stddev_population }
    else if function == 9 { aggregate = native_range_sum }
    else if function == 10 { aggregate = native_range_variance_estimate }
    else { aggregate = native_range_variance_population }

    collector: NativeSubtotalCollector
    collector.function = function
    collector.ignore_hidden = ignore_hidden
    collector.base_position = eval_info.position
    defer { native_g_free(cast(*void)collector.values) }
    visit: NativeIterateValuesCallback = NativeSubtotalVisit
    visit_opaque: *void
    MemoryCopy(cast(*void)*visit_opaque, cast(*void)*visit, size_of(*void))
    remaining: **void = null
    remaining_count: s32 = 0
    remaining_capacity: s32 = 0
    error: *void
    argument: s32 = 1
    while argument < argc {
        reference: *NativeCellReference = native_expression_cellref(argv[argument])
        if reference != null {
            reference_position: NativeEvalPosition
            reference_position.eval.col = native_cellref_col(reference, eval_info.position)
            reference_position.eval.row = native_cellref_row(reference, eval_info.position)
            reference_position.sheet = ifx reference.sheet != null then reference.sheet else eval_info.position.sheet
            reference_position.dependent = null
            reference_position.array_expression = null
            node: *void = native_cell(reference_position.sheet, reference_position.eval.col, reference_position.eval.row)
            if node != null {
                source: *s8 = native_source(node)
                nested: Cell
                nested.kind = CELL_FORMULA
                nested.text = source
                skip: bool = CellHasSubtotal(*nested)
                native_free(cast(*void)source)
                if skip { argument += 1; continue }
            }
            reference_value: *void = native_expression_evaluate(argv[argument], eval_info.position, 2)
            error = NativeSubtotalVisit(*reference_position, reference_value, cast(*void)*collector)
            if reference_value != null { native_value_release(reference_value) }
            if error != null {
                native_g_free(cast(*void)remaining)
                return error
            }
        } else {
            if remaining_count == remaining_capacity {
                remaining_capacity = remaining_capacity * 2 + 4
                remaining = cast(**void)native_realloc(
                    cast(*void)remaining,
                    cast(usize)remaining_capacity * size_of(*void)
                )
            }
            remaining[remaining_count] = argv[argument]
            remaining_count += 1
        }
        argument += 1
    }
    error = native_iterate_values(
        eval_info.position,
        visit_opaque,
        cast(*void)*collector,
        remaining_count,
        remaining,
        0,
        24
    )
    native_g_free(cast(*void)remaining)
    if error != null { return error }
    result: float64 = 0
    if collector.count == 0 && (function == 4 || function == 5) { return native_new_float(0) }
    if aggregate(collector.values, collector.count, *result) != 0 {
        return native_new_error_div0(eval_info.position)
    }
    return native_new_float(result)
}

#scope_export
NativeReady :: () -> bool {
    #if #defined(ANDROID_BUILD) || #defined(PLATFORM_WEB) || #defined(WORKBOOK_PORTABLE) {
        // These hosts use Workbook's own calculation and document engine.
        // Never try to load a desktop library on a phone or in the browser.
        return false
    } else {
        if native_tried { return native_ready }
        native_tried = true
        native_library = NativeOpenLibrary(CText("libspreadsheet.so"), 1)
        if native_library == null { return false }
        ok: bool = true
        ok = ok && NativeResolve(cast(*void)*native_pre_init, "gnm_pre_parse_init")
        ok = ok && NativeResolve(cast(*void)*native_initialize, "gnm_init")
        ok = ok && NativeResolve(cast(*void)*native_new_context, "gnm_cmd_context_stderr_new")
        ok = ok && NativeResolve(cast(*void)*native_plugins_init, "gnm_plugins_init")
        ok = ok && NativeResolve(cast(*void)*native_plugins, "go_plugins_get_available_plugins")
        ok = ok && NativeResolve(cast(*void)*native_activate, "go_plugin_db_activate_plugin_list")
        ok = ok && NativeResolve(cast(*void)*native_error_free, "go_error_info_free")
        ok = ok && NativeResolve(cast(*void)*native_new_io, "go_io_context_new")
        ok = ok && NativeResolve(cast(*void)*native_io_failed, "go_io_error_occurred")
        ok = ok && NativeResolve(cast(*void)*native_release, "g_object_unref")
        ok = ok && NativeResolve(cast(*void)*native_free, "g_free")
        ok = ok && NativeResolve(cast(*void)*native_get_name, "g_object_get")
        ok = ok && NativeResolve(cast(*void)*native_array_release, "g_ptr_array_unref")
        ok = ok && NativeResolve(cast(*void)*native_input_memory, "gsf_input_memory_new")
        ok = ok && NativeResolve(cast(*void)*native_read, "workbook_view_new_from_input")
        ok = ok && NativeResolve(cast(*void)*native_book, "wb_view_get_workbook")
        ok = ok && NativeResolve(cast(*void)*native_sheet_count, "workbook_sheet_count")
        ok = ok && NativeResolve(cast(*void)*native_sheet, "workbook_sheet_by_index")
        ok = ok && NativeResolve(cast(*void)*native_positions, "sheet_cell_positions")
        ok = ok && NativeResolve(cast(*void)*native_cell, "sheet_cell_get")
        ok = ok && NativeResolve(cast(*void)*native_fetch, "sheet_cell_fetch")
        ok = ok && NativeResolve(cast(*void)*native_source, "gnm_cell_get_entered_text")
        ok = ok && NativeResolve(cast(*void)*native_display, "gnm_cell_get_rendered_text")
        ok = ok && NativeResolve(cast(*void)*native_format, "gnm_cell_get_format")
        ok = ok && NativeResolve(cast(*void)*native_general, "go_format_is_general")
        ok = ok && NativeResolve(cast(*void)*native_value, "gnm_cell_get_value")
        ok = ok && NativeResolve(cast(*void)*native_value_type, "value_type_of")
        ok = ok && NativeResolve(cast(*void)*native_number, "value_get_as_float")
        ok = ok && NativeResolve(cast(*void)*native_value_text, "value_get_as_string")
        ok = ok && NativeResolve(cast(*void)*native_recalculate, "workbook_recalc_all")
        ok = ok && NativeResolve(cast(*void)*native_set_text, "sheet_cell_set_text")
        ok = ok && NativeResolve(cast(*void)*native_remove, "sheet_cell_remove")
        ok = ok && NativeResolve(cast(*void)*native_array_cell, "gnm_cell_is_nonsingleton_array")
        ok = ok && NativeResolve(cast(*void)*native_insert_rows, "sheet_insert_rows")
        ok = ok && NativeResolve(cast(*void)*native_delete_rows, "sheet_delete_rows")
        ok = ok && NativeResolve(cast(*void)*native_insert_cols, "sheet_insert_cols")
        ok = ok && NativeResolve(cast(*void)*native_delete_cols, "sheet_delete_cols")
        ok = ok && NativeResolve(cast(*void)*native_row_hidden, "sheet_row_is_hidden")
        ok = ok && NativeResolve(cast(*void)*native_set_visibility, "colrow_set_visibility")
        ok = ok && NativeResolve(cast(*void)*native_function_lookup, "gnm_func_lookup")
        ok = ok && NativeResolve(cast(*void)*native_function_load, "gnm_func_load_if_stub")
        ok = ok && NativeResolve(cast(*void)*native_function_set_varargs, "gnm_func_set_varargs")
        ok = ok && NativeResolve(cast(*void)*native_expression_evaluate, "gnm_expr_eval")
        ok = ok && NativeResolve(cast(*void)*native_expression_cellref, "gnm_expr_get_cellref")
        ok = ok && NativeResolve(cast(*void)*native_cellref_col, "gnm_cellref_get_col")
        ok = ok && NativeResolve(cast(*void)*native_cellref_row, "gnm_cellref_get_row")
        ok = ok && NativeResolve(cast(*void)*native_value_as_int, "value_get_as_int")
        ok = ok && NativeResolve(cast(*void)*native_value_release, "value_release")
        ok = ok && NativeResolve(cast(*void)*native_value_duplicate, "value_dup")
        ok = ok && NativeResolve(cast(*void)*native_new_error_num, "value_new_error_NUM")
        ok = ok && NativeResolve(cast(*void)*native_new_error_div0, "value_new_error_DIV0")
        ok = ok && NativeResolve(cast(*void)*native_new_error_value, "value_new_error_VALUE")
        ok = ok && NativeResolve(cast(*void)*native_new_float, "value_new_float")
        ok = ok && NativeResolve(cast(*void)*native_iterate_values, "function_iterate_argument_values")
        ok = ok && NativeResolve(cast(*void)*native_realloc, "g_realloc")
        ok = ok && NativeResolve(cast(*void)*native_g_free, "g_free")
        ok = ok && NativeResolve(cast(*void)*native_range_average, "go_range_average")
        ok = ok && NativeResolve(cast(*void)*native_range_count, "gnm_range_count")
        ok = ok && NativeResolve(cast(*void)*native_range_maximum, "go_range_max")
        ok = ok && NativeResolve(cast(*void)*native_range_minimum, "go_range_min")
        ok = ok && NativeResolve(cast(*void)*native_range_product, "gnm_range_product")
        ok = ok && NativeResolve(cast(*void)*native_range_stddev_estimate, "gnm_range_stddev_est")
        ok = ok && NativeResolve(cast(*void)*native_range_stddev_population, "gnm_range_stddev_pop")
        ok = ok && NativeResolve(cast(*void)*native_range_sum, "go_range_sum")
        ok = ok && NativeResolve(cast(*void)*native_range_variance_estimate, "gnm_range_var_est")
        ok = ok && NativeResolve(cast(*void)*native_range_variance_population, "gnm_range_var_pop")
        ok = ok && NativeResolve(cast(*void)*native_saver, "go_file_saver_for_id")
        ok = ok && NativeResolve(cast(*void)*native_output_file, "gsf_output_stdio_new")
        ok = ok && NativeResolve(cast(*void)*native_output_memory, "gsf_output_memory_new")
        ok = ok && NativeResolve(cast(*void)*native_output_size, "gsf_output_size")
        ok = ok && NativeResolve(cast(*void)*native_output_bytes, "gsf_output_memory_get_bytes")
        ok = ok && NativeResolve(cast(*void)*native_output_closed, "gsf_output_is_closed")
        ok = ok && NativeResolve(cast(*void)*native_output_close, "gsf_output_close")
        ok = ok && NativeResolve(cast(*void)*native_write, "workbook_view_save_to_output")
        ok = ok && NativeResolve(cast(*void)*native_current_sheet, "wb_view_cur_sheet")
        ok = ok && NativeResolve(cast(*void)*native_focus_sheet, "wb_view_sheet_focus")
        ok = ok && NativeResolve(cast(*void)*native_error_release, "g_error_free")
        ok = ok && NativeResolve(cast(*void)*native_opener, "go_file_opener_for_id")
        ok = ok && NativeResolve(cast(*void)*native_canonical_path, "g_canonicalize_filename")
        ok = ok && NativeResolve(cast(*void)*native_filename_uri, "g_filename_to_uri")
        ok = ok && NativeResolve(cast(*void)*native_document_uri, "go_doc_get_uri")
        if !ok { return false }
        argv: [2]*s8
        argv[0] = CText("workbook")
        // Gnumeric's start-up adopts the user's locale. Restore Workbook's
        // afterwards, so a decimal comma never reaches its number parser or display.
        saved: [256]s8
        current := NativeSetLocale(NATIVE_LC_ALL, null)
        kept := current != null && TextLength(current) < 256
        if kept { unused MemoryCopy(cast(*void)*saved[0], cast(*void)current, TextLength(current) + 1) }
        unused native_pre_init(1, *argv[0])
        native_initialize()
        native_context = native_new_context()
        native_plugins_init(native_context)
        error: *void
        native_activate(native_plugins(), *error)
        // Optional plugin activation failures do not disable the core reader.
        if error != null { native_error_free(error) }
        if kept { unused NativeSetLocale(NATIVE_LC_ALL, *saved[0]) }
        subtotal: *void = native_function_lookup(CText("SUBTOTAL"), null)
        if subtotal == null { return false }
        native_function_load(subtotal)
        subtotal_callback: NativeFunctionNodes = NativeSubtotal
        subtotal_callback_opaque: *void
        MemoryCopy(cast(*void)*subtotal_callback_opaque, cast(*void)*subtotal_callback, size_of(*void))
        native_function_set_varargs(subtotal, subtotal_callback_opaque, null)
        native_ready = true
        return true
    }
}

NativeRead :: (bytes: *u8, count: s64, uri: *s8 = null) -> *void {
    if !NativeReady() { return null }
    input: *void = native_input_memory(bytes, count, 0)
    if input == null { return null }
    io: *void = native_new_io(native_context)
    opener: *void = native_opener(CText("Gnumeric_XmlIO:sax"))
    view: *void
    if opener != null { view = native_read(input, uri, opener, io, null) }
    failed: bool = native_io_failed(io) != 0
    native_release(io)
    native_release(input)
    if failed && view != null { native_release(view); view = null }
    return view
}

// Supply the source URI so Gnumeric can resolve relative workbook links.
NativeReadDocument :: (bytes: *u8, count: s64, path: *s8) -> *void {
    if !NativeReady() { return null }
    absolute: *s8 = native_canonical_path(path, null)
    if absolute == null { return null }
    uri: *s8 = native_filename_uri(absolute, null, null)
    native_free(cast(*void)absolute)
    if uri == null { return null }
    view: *void = NativeRead(bytes, count, uri)
    native_free(cast(*void)uri)
    return view
}

NativeClose :: (view: *void) { if view != null { native_release(view) } }

NativeWriteOutput :: (view: *void, output: *void, format: *s8) -> bool {
    saver: *void = native_saver(format)
    if saver == null { return false }
    io: *void = native_new_io(native_context)
    native_write(view, saver, output, io)
    ok: bool = native_io_failed(io) == 0
    if native_output_closed(output) == 0 {
        if native_output_close(output) == 0 { ok = false }
    }
    native_release(io)
    return ok
}

NativeSave :: (view: *void, path: *s8, csv: bool) -> s32 {
    error: *void
    // CSV is also written to pipes such as /dev/stdout. The native file
    // output requires a seekable file; its memory output has no such limit.
    output: *void = ifx csv then native_output_memory() else native_output_file(path, *error)
    if output == null {
        if error != null { native_error_release(error) }
        return 0
    }
    previous: *void = native_current_sheet(view)
    if csv { native_focus_sheet(view, native_sheet(native_book(view), 0)) }
    ok: bool = NativeWriteOutput(view, output,
        ifx csv then CText("Gnumeric_stf:stf_csv") else CText("Gnumeric_XmlIO:sax"))
    if csv {
        native_focus_sheet(view, previous)
        if ok {
            count: s64 = native_output_size(output)
            bytes: *s8 = cast(*s8)MemoryAllocate(cast(u64)count + 1)
            if bytes == null { ok = false }
            else {
                MemoryCopy(cast(*void)bytes, cast(*void)native_output_bytes(output), cast(u64)count)
                bytes[count] = 0
                ok = WriteFileText(path, bytes)
                MemoryFree(cast(*void)bytes)
            }
        }
    }
    native_release(output)
    return ifx ok then 1 else 0
}

NativeClone :: (view: *void) -> *void {
    output: *void = native_output_memory()
    if output == null { return null }
    copy: *void
    if NativeWriteOutput(view, output, CText("Gnumeric_XmlIO:sax")) {
        copy = NativeRead(native_output_bytes(output), native_output_size(output), native_document_uri(native_book(view)))
    }
    native_release(output)
    return copy
}

NativeRefresh :: (wb: *Workbook) -> s32 {
    // All model text is owned by Workbook; native pointers never outlive a
    // call. Rebuilding also picks up dependencies changed by an edit.
    for i: 0..wb.sheet_count - 1 { SheetFree(*wb.sheets[i]) }
    wb.sheet_count = 0
    book: *void = native_book(wb.native)
    native_recalculate(book)
    count: s32 = native_sheet_count(book)
    index: s32 = 0
    while index < count {
        source: *void = native_sheet(book, index)
        name: *s8
        native_get_name(source, CText("name"), *name, null)
        sheet: *Sheet = WorkbookAddSheet(wb, name)
        native_free(cast(*void)name)
        if sheet == null { return 0 }
        positions: *NativeArray = native_positions(source, 0)
        if positions != null {
            at: u32 = 0
            while at < positions.count {
                position: *NativePosition = cast(*NativePosition)positions.data[at]
                node: *void = native_cell(source, position.col, position.row)
                cell: *Cell = CellObtain(sheet, position.row, position.col)
                if cell != null && node != null {
                    cell.text = native_source(node)
                    value: *void = native_value(node)
                    kind: s32 = native_value_type(value)
                    cell.kind = ifx cell.text != null && cell.text[0] == 61 then CELL_FORMULA else CELL_LITERAL
                    cell.computed = 1
                    if kind == 20 || kind == 40 {
                        cell.cached_kind = ifx kind == 20 then VAL_BOOL else VAL_FLOAT
                        cell.cached_number = native_number(value)
                    } else if kind == 50 {
                        cell.cached_kind = VAL_ERROR
                        message: *s8 = native_value_text(value)
                        cell.cached_err = ErrFromText(message)
                        native_free(cast(*void)message)
                    } else if kind == 60 {
                        cell.cached_kind = VAL_STRING
                        cell.cached_text = native_value_text(value)
                    }
                }
                at += 1
            }
            native_array_release(cast(*void)positions)
        }
        SheetExtent(sheet)
        index += 1
    }
    return 1
}

NativeSet :: (wb: *Workbook, index: s32, row: s32, col: s32, text: *s8) -> s32 {
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null { return 0 }
    cell: *void = native_cell(sheet, col, row)
    // Match Gnumeric: an array cannot be changed one constituent cell at a time.
    if cell != null && native_array_cell(cell) != 0 { return 0 }
    if text == null || text[0] == 0 {
        if cell != null { native_remove(sheet, cell, 0, 1) }
    } else {
        cell = native_fetch(sheet, col, row)
        if cell == null { return 0 }
        native_set_text(cell, text, null)
    }
    return NativeRefresh(wb)
}

NativeShift :: (wb: *Workbook, index: s32, at: s32, rows: bool, insert: bool) -> s32 {
    sheet: *void = native_sheet(native_book(wb.native), index)
    result: s32
    if rows {
        if insert { result = native_insert_rows(sheet, at, 1, null, native_context) }
        else { result = native_delete_rows(sheet, at, 1, null, native_context) }
    } else {
        if insert { result = native_insert_cols(sheet, at, 1, null, native_context) }
        else { result = native_delete_cols(sheet, at, 1, null, native_context) }
    }
    if result != 0 { return 0 }
    return NativeRefresh(wb)
}

NativeRowHidden :: (wb: *Workbook, index: s32, row: s32) -> s32 {
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null || row < 0 || row >= WB_MAX_ROWS {
        return 0
    }
    return native_row_hidden(sheet, row)
}

NativeSetRowsHidden :: (wb: *Workbook, index: s32, first: s32, last: s32, hidden: s32) -> s32 {
    sheet: *void = native_sheet(native_book(wb.native), index)
    if sheet == null {
        return 0
    }
    native_set_visibility(sheet, 0, ifx hidden == 0 then 1 else 0, first, last)
    return NativeRefresh(wb)
}

NativeDisplay :: (wb: *Workbook, index: s32, row: s32, col: s32, out: *s8, cap: s32) {
    out[0] = 0
    sheet: *void = native_sheet(native_book(wb.native), index)
    cell: *void = native_cell(sheet, col, row)
    if cell == null { return }
    // A number in the General format gets Workbook's grid rule rather than
    // as many digits as fit the column; an explicit number format is kept.
    value: *void = native_value(cell)
    if native_value_type(value) == 40 && native_general(native_format(cell)) != 0 {
        FormatNumber(native_number(value), out, cap)
        RoundForDisplay(out, cap)
        return
    }
    text: *s8 = native_display(cell)
    if text != null {
        FormatText(out, cast(usize)cap, CText("%s"), text)
        native_free(cast(*void)text)
    }
}
